# ── Aioxy ──────────────────────────────────────────────────────────────────
# For a self-hosted deploy (Docker). On Vercel set these with `vercel env add`
# instead — the platform injects them and this file is not used.
#
# There is no paper mode: agents trade on chain or the runner refuses to start.

# ═══ REQUIRED ══════════════════════════════════════════════════════════════

# Postgres. Provision with `vercel integration add neon`, which sets this on the
# project automatically. The app creates its own tables on first query — there
# is no migration step to run.
DATABASE_URL=

# House wallet. Pays the gas top-up that lets a new agent trade without the user
# ever needing STT, and is the account `npm run doctor` / `npm run smoke` act as.
# Needs STT. Without it the runner refuses to start.
PRIVATE_KEY=

# Encrypts agent private keys before they reach the database (AES-256-GCM).
# Rotating this makes every stored agent key unreadable: users can still
# re-derive theirs from a signature, but this deployment forgets their agents.
#   openssl rand -hex 24
AGENT_KEY_SECRET=

# Guards /api/agent/trade and /api/tick. Unset means those routes refuse every
# request — safe, but the gate scripts stop working.
#   openssl rand -hex 24
INTERNAL_SECRET=

# ═══ REQUIRED ON VERCEL ════════════════════════════════════════════════════

# Vercel Cron sends this as `Authorization: Bearer <value>`. A serverless
# function cannot hold the runner's interval, so that cron IS the clock there —
# without this, the site serves fine and no agent ever trades.
#   openssl rand -hex 24
CRON_SECRET=

# ═══ OPTIONAL — endpoints ══════════════════════════════════════════════════
# Defaults are the public Somnia Shannon testnet.
# INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# PRICE_FEED_URL=https://price-feed.dev.oracle.somnia.host/v1/graphql
# RPC_URL=https://dream-rpc.somnia.network
# WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# EXPLORER_URL=https://shannon-explorer.somnia.network
# CHAIN_ID=50312

# ═══ OPTIONAL — runner ═════════════════════════════════════════════════════
# Tick cadence in ms, used only where the process stays alive (not on Vercel).
# TICK_MS=3000

# How far past the quoted price a taker will pay in order to cross. The book
# comes from the indexer, which lags the chain: an order priced at exactly the
# level we read reverts ImmediateOrCancelNoFill the moment that level moves.
# CROSSING_BUFFER=0.02

# Set to 1 to run the UI with the runner stopped. Used by the Docker build.
# DISABLE_AGENTS=0

# ═══ OPTIONAL — gas policy (wei) ═══════════════════════════════════════════
# What the house sends a newly deployed agent, the balance above which it does
# not bother, and the floor below which it stops funding strangers so it can
# still pay its own gas.
# AGENT_GAS_TOPUP_WEI=200000000000000000
# AGENT_GAS_MIN_WEI=100000000000000000
# HOUSE_GAS_FLOOR_WEI=5000000000000000000

# ═══ SCRIPTS ONLY ══════════════════════════════════════════════════════════
# Used by scripts/*.mjs, never by the app.
# BASE_URL=http://localhost:4311          # which server the gates drive
# OWNER_PRIVATE_KEY=0x...                 # scripts/prove.mjs — defaults to PRIVATE_KEY
# OPERATOR_PRIVATE_KEY=0x...              # scripts/prove.mjs — gas only, holds no collateral
# SQLITE_PATH=./.data/aioxy.db            # scripts/migrate-to-postgres.mjs source
